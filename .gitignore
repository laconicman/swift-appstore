# NOTE: committed on purpose (not build-plugin output):
#   Sources/AppStoreOpenAPI/openapi.json         — Apple's spec, vendored + normalized by asc-spec-tool
#   Sources/AppStoreOpenAPI/spec-manifest.json   — pin (version, upstream/vendored sha256, counts)
# The generated Client.swift / Types.swift live under .build and are NOT committed.
